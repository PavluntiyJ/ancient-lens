#!/bin/sh
# Run the CI checks locally before pushing to main. Skip with: git push --no-verify
set -e

pushes_main=false
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] && pushes_main=true
done
[ "$pushes_main" = true ] || exit 0

echo "pre-push: running checks before pushing to main..."
npm run format:check
cargo fmt --manifest-path src-tauri/Cargo.toml --check
npm run check
npm run check:public
npm run build:web
npm run test:rust
cargo check --manifest-path src-tauri/Cargo.toml --no-default-features --bin stats-service
