{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ancient Lens",
  "version": "0.5.0",
  "identifier": "org.ancientlens.desktop",
  "build": {
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ancient Lens",
        "decorations": false,
        "width": 1740,
        "height": 1100,
        "minWidth": 1030,
        "minHeight": 650,
        "center": true,
        "alwaysOnTop": true,
        "create": false
      },
      {
        "label": "profile",
        "title": "Ancient Lens: profile",
        "decorations": false,
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "alwaysOnTop": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.cloudflare.steamstatic.com https://avatars.steamstatic.com https://avatars.akamai.steamstatic.com https://avatars.cloudflare.steamstatic.com https://avatars.steamcommunity.com; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../build/icon.ico",
      "../build/icon-128.png",
      "../build/icon.png"
    ]
  }
}
